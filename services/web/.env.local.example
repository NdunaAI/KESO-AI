NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
# TODO: remove once a real login form is wired up against POST /auth/login
# (docs/03-api-specification.md #3.4); until then, paste the access_token
# and refresh_token from that endpoint's response here to let the chat UI
# call an already-authenticated API Gateway in dev. The client refreshes
# the access token automatically as it nears expiry (lib/api.ts), so the
# refresh token is what actually keeps a dev session usable beyond 15 min.
NEXT_PUBLIC_DEV_BEARER_TOKEN=
NEXT_PUBLIC_DEV_REFRESH_TOKEN=
