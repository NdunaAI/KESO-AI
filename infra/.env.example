# Copy to KESO-AI/.env (or infra/.env if invoking compose from infra/) and fill in real values.
# Never commit the filled-in .env file.

# --- Postgres (KESO AI's own app DB: conversations, feedback, audit log -- see docs/04-data-model.md #4.1) ---
POSTGRES_PASSWORD=changeme

# --- Operational DB: Oracle (read-only account, used by oracledb-mcp-server) ---
ORACLE_DSN=oracle-db.keso.internal:1521/UISPRO
ORACLE_USER=keso_ai_readonly
ORACLE_PASSWORD=changeme
# Only needed for Oracle Autonomous DB / mTLS wallet-based connections; leave blank for plain TCP.
ORACLE_WALLET_LOCATION=

# --- Local documents (mounted read-only into mcp-filesystem / ingestion) ---
KESO_DOCS_ROOT=../data/sample-docs

# --- SharePoint / Entra ID app registration (mcp-sharepoint) ---
SHAREPOINT_TENANT_ID=
SHAREPOINT_CLIENT_ID=
SHAREPOINT_CLIENT_SECRET=
SHAREPOINT_SITE_ID=

# --- GIS / REST allow-list (mcp-fetch) ---
GIS_ALLOWED_HOSTS=gis.keso.internal

# --- Keycloak bootstrap admin ---
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=changeme

# --- Grafana ---
GRAFANA_ADMIN_PASSWORD=admin

# --- Models ---
LLM_MODEL=llama3.1:8b-instruct
EMBEDDING_MODEL=nomic-embed-text
