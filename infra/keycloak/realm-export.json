{
  "realm": "keso",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "roles": {
    "realm": [
      { "name": "project_manager", "description": "Project Manager" },
      { "name": "financial_officer", "description": "Financial Officer" },
      { "name": "me_officer", "description": "Monitoring & Evaluation Officer" },
      { "name": "auditor", "description": "Auditor" },
      { "name": "executive", "description": "Executive User" },
      { "name": "keso_admin", "description": "KESO AI administrator (ops/config screens)" }
    ]
  },
  "clients": [
    {
      "clientId": "keso-web",
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["http://localhost:3000/*"],
      "webOrigins": ["http://localhost:3000"],
      "attributes": { "pkce.code.challenge.method": "S256" }
    },
    {
      "clientId": "keso-api-gateway",
      "publicClient": false,
      "bearerOnly": true,
      "protocol": "openid-connect"
    },
    {
      "clientId": "keso-mcp-sharepoint",
      "publicClient": false,
      "bearerOnly": false,
      "protocol": "openid-connect",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false
    }
  ],
  "clientScopes": [
    {
      "name": "keso-scope",
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "keso-scope-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "keso_scope",
            "claim.name": "keso.scope",
            "jsonType.label": "JSON",
            "id.token.claim": "true",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "pm.demo",
      "enabled": true,
      "email": "pm.demo@keso.org",
      "credentials": [{ "type": "password", "value": "changeme", "temporary": true }],
      "realmRoles": ["project_manager"],
      "attributes": { "keso_scope": ["{\"projects\":[\"PRJ-001\"],\"settlements\":[\"A\",\"C\"]}"] }
    },
    {
      "username": "finance.demo",
      "enabled": true,
      "email": "finance.demo@keso.org",
      "credentials": [{ "type": "password", "value": "changeme", "temporary": true }],
      "realmRoles": ["financial_officer"],
      "attributes": { "keso_scope": ["{\"projects\":[\"*\"],\"settlements\":[\"*\"]}"] }
    },
    {
      "username": "auditor.demo",
      "enabled": true,
      "email": "auditor.demo@keso.org",
      "credentials": [{ "type": "password", "value": "changeme", "temporary": true }],
      "realmRoles": ["auditor"],
      "attributes": { "keso_scope": ["{\"projects\":[\"*\"],\"settlements\":[\"*\"]}"] }
    }
  ]
}
